)

assumptions = {
    "priority_1": priority_1,
    "priority_2": priority_2,
    "priority_3": priority_3,
    "admin_agent_bonus": admin_agent_bonus,
    "sponsor_bonus": sponsor_bonus,
    "no_competition_bonus": no_competition_bonus,
    "competition_penalty": competition_penalty,
    "high_wallet_share_threshold": 0.30,
    "low_wallet_share_threshold": 0.10,
    "high_wallet_share_bonus": 0.10,
    "low_wallet_share_penalty": -0.05,
    "min_probability": 0.05,
    "max_probability": 0.85
}

# -----------------------------
# Main app
# -----------------------------

if uploaded_file is None:
    st.info("Upload your borrower Excel workbook to begin.")
    st.stop()

df = pd.read_excel(uploaded_file, sheet_name="Borrower_Input")

df.columns = df.columns.astype(str).str.strip()
df = df.dropna(how="all")

required_columns = [
    "Borrower",
    "Sponsor",
    "Admin Agent",
    "Risk Rating",
    "Prioritization",
    "Wallet Share",
    "Hold Amount",
    "Total Facility Commitments",
    "Latest Cash on Balance Sheet",
    "TPS Revenue Potential",
    "Top 15 Treasury Banks in Bank Group",
    "Revenue Assumption"
]

missing_columns = [col for col in required_columns if col not in df.columns]

if missing_columns:
    st.error(f"Missing required columns: {missing_columns}")
    st.stop()

# -----------------------------
# Clean workbook inputs
# -----------------------------

text_columns = [
    "Borrower",
    "Sponsor",
    "Admin Agent",
    "Risk Rating",
    "Revenue Assumption"
]

for col in text_columns:
    df[col] = df[col].fillna("").astype(str).str.strip()

numeric_columns = [
    "Prioritization",
    "Wallet Share",
    "Hold Amount",
    "Total Facility Commitments",
    "Latest Cash on Balance Sheet",
    "TPS Revenue Potential",
    "Top 15 Treasury Banks in Bank Group"
]

for col in numeric_columns:
    df[col] = df[col].apply(clean_numeric)

# Calculate model outputs
probability_results = df.apply(
    lambda row: calculate_probability(row, assumptions),
    axis=1
)

df["Win Probability"] = probability_results.apply(lambda x: x[0])
df["Score Explanation"] = probability_results.apply(lambda x: x[1])

df["Deposit Revenue Potential"] = df["Latest Cash on Balance Sheet"].apply(
    lambda cash: calculate_deposit_revenue(
        cash,
        tier_1_deposit_revenue,
        tier_2_deposit_revenue
    )
)

df["Total Revenue Opportunity"] = (
    df["TPS Revenue Potential"].fillna(0)
    + df["Deposit Revenue Potential"].fillna(0)
)

df["Expected Revenue"] = (
    df["Win Probability"] * df["Total Revenue Opportunity"]
)

df["Win Probability %"] = df["Win Probability"] * 100

df["Action"] = df.apply(assign_action, axis=1)
df["Reason Code"] = df.apply(create_reason_code, axis=1)

df["Rank"] = df["Expected Revenue"].rank(
    ascending=False,
    method="dense"
).astype(int)

df = df.sort_values("Expected Revenue", ascending=False)
