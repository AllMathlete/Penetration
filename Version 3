st.set_page_config(
    page_title="TPS Borrower Targeting Dashboard",
    layout="wide"
)

st.title("TPS Borrower Targeting Dashboard")
st.caption("Probability-weighted treasury revenue prioritization model for existing borrowers")

uploaded_file = st.file_uploader("Upload borrower Excel workbook", type=["xlsx"])

# -----------------------------
# Helper functions
# -----------------------------

def clean_numeric(value):
    if pd.isna(value):
        return 0

    value = str(value).strip()

    if value.lower() in ["", "na", "n/a", "nan", "none", "-", "--", "#n/a"]:
        return 0

    value = (
        value.replace("$", "")
        .replace(",", "")
        .replace("%", "")
        .strip()
    )

    return pd.to_numeric(value, errors="coerce") if pd.notna(pd.to_numeric(value, errors="coerce")) else 0


def clean_percent(value):
    value = clean_numeric(value)

    if value > 1:
        return value / 100

    return value


def calculate_deposit_revenue(cash, tier_1_revenue, tier_2_revenue):
    cash = clean_numeric(cash)

    if cash >= 200_000_000:
        return tier_2_revenue
    if cash >= 50_000_000:
        return tier_1_revenue
    return 0


def calculate_probability(row, assumptions):
    priority = clean_numeric(row.get("Prioritization", 3))

    if priority == 1:
        probability = assumptions["priority_1"]
    elif priority == 2:
        probability = assumptions["priority_2"]
    else:
        probability = assumptions["priority_3"]

    admin_agent = str(row.get("Admin Agent", "")).lower()
    sponsor = str(row.get("Sponsor", "")).lower()
    wallet_share = clean_percent(row.get("Wallet Share", 0))
    competitors = clean_numeric(row.get("Top 15 Treasury Banks in Bank Group", 0))

    adjustments = {}

    if "bmo" in admin_agent:
        adjustments["Admin agent"] = assumptions["admin_agent_bonus"]
        probability += assumptions["admin_agent_bonus"]
    else:
        adjustments["Admin agent"] = 0

    if sponsor not in ["", "nan", "none", "na", "n/a"]:
        adjustments["Sponsor relationship"] = assumptions["sponsor_bonus"]
        probability += assumptions["sponsor_bonus"]
    else:
        adjustments["Sponsor relationship"] = 0

    if wallet_share >= assumptions["high_wallet_share_threshold"]:
        adjustments["High wallet share"] = assumptions["high_wallet_share_bonus"]
        probability += assumptions["high_wallet_share_bonus"]
    elif wallet_share <= assumptions["low_wallet_share_threshold"]:
        adjustments["Low wallet share"] = assumptions["low_wallet_share_penalty"]
        probability += assumptions["low_wallet_share_penalty"]
    else:
        adjustments["Wallet share"] = 0

    if competitors >= 2:
        adjustments["Competition penalty"] = assumptions["competition_penalty"]
        probability += assumptions["competition_penalty"]
    elif competitors == 0:
        adjustments["No competition bonus"] = assumptions["no_competition_bonus"]
        probability += assumptions["no_competition_bonus"]
    else:
        adjustments["Competition"] = 0

    probability = max(
        assumptions["min_probability"],
        min(probability, assumptions["max_probability"])
    )

    return probability, adjustments


def assign_action(row):
    probability = row["Win Probability"]
    expected_revenue = row["Expected Revenue"]
    deposit_revenue = row["Deposit Revenue Potential"]

    if probability >= 0.60 and expected_revenue >= 250_000:
        return "Pursue now"
    if deposit_revenue >= 225_000 and probability >= 0.35:
        return "Deposit-first pitch"
    if probability >= 0.35 and expected_revenue >= 150_000:
        return "Sponsor angle"
    if probability >= 0.20:
        return "Monitor"
    return "Low priority"


def create_reason_code(row):
    reasons = []

    if row["Prioritization"] == 1:
        reasons.append("low treasury competition")
    elif row["Prioritization"] == 2:
        reasons.append("moderate treasury competition")
    else:
        reasons.append("heavy treasury competition")

    if "bmo" in str(row["Admin Agent"]).lower():
        reasons.append("BMO admin agent")

    if row["Deposit Revenue Potential"] > 0:
        reasons.append("deposit opportunity")

    if row["Expected Revenue"] >= 250_000:
        reasons.append("meaningful expected revenue")

    return "; ".join(reasons)


