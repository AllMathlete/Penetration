    sorted(df["Sponsor"].dropna().unique())
)

risk_filter = st.sidebar.multiselect(
    "Risk Rating",
    sorted(df["Risk Rating"].dropna().unique())
)

priority_filter = st.sidebar.multiselect(
    "Prioritization",
    sorted(df["Prioritization"].dropna().unique())
)

action_filter = st.sidebar.multiselect(
    "Action",
    sorted(df["Action"].dropna().unique())
)

filtered_df = df.copy()

if sponsor_filter:
    filtered_df = filtered_df[filtered_df["Sponsor"].isin(sponsor_filter)]

if risk_filter:
    filtered_df = filtered_df[filtered_df["Risk Rating"].isin(risk_filter)]

if priority_filter:
    filtered_df = filtered_df[filtered_df["Prioritization"].isin(priority_filter)]

if action_filter:
    filtered_df = filtered_df[filtered_df["Action"].isin(action_filter)]

# -----------------------------
# Summary tiles
# -----------------------------

st.subheader("Leadership Summary")

